{
  "name": "protoc-gen-es-string-descriptor",
  "version": "0.0.1",
  "description": "A protoc-gen-es drop-in replacement that makes file descriptors diff-friendly by splitting them into multi-line raw byte string literals",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    }
  },
  "bin": {
    "protoc-gen-es-string-descriptor": "./dist/bin.js"
  },
  "scripts": {
    "build": "tsc",
    "check": "biome check --write",
    "knip": "knip --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "changeset:version": "changeset version",
    "changeset:release": "pnpm build && changeset publish"
  },
  "files": [
    "dist",
    "src",
    "!**/__tests__/**",
    "!**/*.test.ts",
    "!**/*.test.js",
    "!**/*.test.d.ts",
    "!**/*.test.js.map",
    "!**/*.test.d.ts.map"
  ],
  "keywords": [
    "protobuf",
    "protoc-gen-es",
    "buf",
    "codegen",
    "diff-friendly",
    "file-descriptor"
  ],
  "author": "izumin5210 <m@izum.in>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/izumin5210/protoc-gen-es-string-descriptor.git"
  },
  "bugs": {
    "url": "https://github.com/izumin5210/protoc-gen-es-string-descriptor/issues"
  },
  "dependencies": {
    "@bufbuild/protoplugin": "^2.0.0"
  },
  "peerDependencies": {
    "@bufbuild/protobuf": "^2.0.0",
    "@bufbuild/protoc-gen-es": "^2.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.6",
    "@bufbuild/protoc-gen-es": "^2.0.0",
    "@bufbuild/buf": "^1.50.0",
    "@bufbuild/protobuf": "^2.0.0",
    "@changesets/changelog-github": "0.6.0",
    "@changesets/cli": "2.30.0",
    "@vitest/coverage-v8": "4.0.18",
    "knip": "5.86.0",
    "typescript": "^5.7.0",
    "vitest": "^4.0.18"
  },
  "packageManager": "pnpm@10.30.1"
}
