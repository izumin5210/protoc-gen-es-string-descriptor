{
  "name": "protoc-gen-es-string-descriptor",
  "version": "0.0.0",
  "description": "A protoc-gen-es wrapper that splits file descriptors into diff-friendly multi-line format",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    }
  },
  "bin": {
    "protoc-gen-es-string-descriptor": "./dist/bin.js"
  },
  "scripts": {
    "build": "tsc",
    "check": "biome check --write",
    "knip": "knip --fix",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "protobuf",
    "protoc-gen-es",
    "codegen"
  ],
  "author": "izumin5210 <m@izum.in>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/izumin5210/protoc-gen-es-string-descriptor.git"
  },
  "bugs": {
    "url": "https://github.com/izumin5210/protoc-gen-es-string-descriptor/issues"
  },
  "dependencies": {
    "@bufbuild/protoc-gen-es": "^2.0.0",
    "@bufbuild/protoplugin": "^2.0.0"
  },
  "peerDependencies": {
    "@bufbuild/protobuf": "^2.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.6",
    "@bufbuild/buf": "^1.50.0",
    "@bufbuild/protobuf": "^2.0.0",
    "@vitest/coverage-v8": "4.0.18",
    "knip": "5.86.0",
    "typescript": "^5.7.0",
    "vitest": "^4.0.18"
  },
  "packageManager": "pnpm@10.30.1"
}
